    "changeDrivenTransforms": false,
    "controlScriptCode": "/**\n * Drone-H743 Ground Control Station Control Script\n *\n * Automatically starts the local high-fidelity telemetry simulator\n * if no physical hardware is connected.\n */\nvar helperPid = -1;\n\nfunction startSimulator() {\n    var dir = system.projectDir();\n    if (!dir.ok) return;\n    var script = dir.result.directory + \"/drone_simulator.py\";\n    var r = system.exec(\"python3\", { args: [\"-u\", script], workingDir: dir.result.directory });\n    if (!r.ok) {\n        r = system.exec(\"python\", { args: [\"-u\", script], workingDir: dir.result.directory });\n    }\n    if (r.ok) {\n        helperPid = r.result.processId;\n    }\n}\n\nfunction onConnect() {\n    startSimulator();\n}\n\nfunction setup() {}\n\nfunction loop() {\n    delay(1000);\n}\n",
