build/
mx.scratch/
Debug/
Release/
cmake-build-*/

# Generated compiler/build artifacts
*.su
*.elf
*.elf.proxy_cache
*.bin
# 例外：黄金向量夹具必须能从干净检出直接跑（R-S1-3 交接门 / 审核 Q6）。
# 它由固件真实编码器产出，是协议契约的一部分，不是构建产物。
!tests/golden/*.bin
# 例外：MicoAir743v2 的出厂固件镜像 —— 这是刷坏之后**唯一的退路**。
# 它原本只存在于 .tmp/ 里，那是公共临时区，任何清理动作都可能把它抹掉，
# 而丢了它就等于失去回到出厂状态的能力。所以纳入版本控制：
# 2 MB 的代价换"删不掉"，值。校验和见 doc/micoair743v2/README.md 的"烧录前基线"。
!doc/micoair743v2/baseline/*.bin
*.hex
*.map
*.o
*.obj
*.d
*.a
*.log

# CMake/Ninja generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_log
.ninja_deps
compile_commands.json
.cmake/
.cache/

# Python runtime cache
__pycache__/
*.py[cod]
.pytest_cache/

# Local OS and IDE state
.DS_Store
.vscode/
.idea/
.settings/
.mxproject
*.launch
CMakeUserPresets.json

# Temporary analysis scripts and data
.tmp/
dis.txt
flightlog_*.csv
flightlog_*.json

# Canonical runtime-generated project data. Curated captures and identification
# datasets elsewhere under data/ remain visible to Git.
data/flight_logs/
data/analysis/
data/logs/
data/telemetry/
data/firmware_updates/
data/calibration/imu_metrology/
# 地面站界面状态：上次连的串口/波特率，每台机器都不一样。
data/panel_state.json

# Serial Studio ground-station debug artifacts. The GUI writes these on every
# launch; gcs_trace.txt in particular accumulates crash dumps.
tools/ground_station/*.log.err
tools/ground_station/gcs_trace.txt
