# Canonical runtime-generated project data. Curated captures and identification
# datasets elsewhere under data/ remain visible to Git.
data/flight_logs/
data/analysis/
data/logs/
data/telemetry/
data/firmware_updates/
data/calibration/imu_metrology/
# 地面站界面状态：上次连的串口/波特率，每台机器都不一样。
data/panel_state.json

# Serial Studio ground-station debug artifacts. The GUI writes these on every
# launch; gcs_trace.txt in particular accumulates crash dumps.
tools/ground_station/*.log.err
tools/ground_station/gcs_trace.txt
